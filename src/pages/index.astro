        <img src="/images/tile-1.webp" alt="Calgary homeowner reviewing written garage quotes at a kitchen table" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Inter',sans-serif;font-size:14.5px;font-weight:800;color:#17191C;padding:14px 12px;">What does a garage cost in Calgary?</span>
      </a>
      <a href="/blog/garage-packages-explained/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(10,61,92,0.1);">
        <img src="/images/tile-2.webp" alt="Framed garage walls showing slab, framing and overhead door inclusions" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Inter',sans-serif;font-size:14.5px;font-weight:800;color:#17191C;padding:14px 12px;">What is actually in a garage package?</span>
      </a>
      <a href="/blog/calgary-garage-permit/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(10,61,92,0.1);">
        <img src="/images/tile-3.webp" alt="Site plan for a detached garage permit application in Calgary" width="700" height="560" style="width:100%;aspect-ratio:1.25/1;object-fit:cover;display:block;" loading="lazy">
        <span style="font-family:'Inter',sans-serif;font-size:14.5px;font-weight:800;color:#17191C;padding:14px 12px;">Do I need a Calgary garage permit?</span>
      </a>
      <a href="/blog/double-garage-size/" style="display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 16px rgba(10,61,92,0.1);">
